---
import Icon from './Icon.astro';
---

<button
  type="button"
  class="control control--icon settings-trigger"
  data-settings-open
  aria-label="站点设置"
  aria-expanded="false"
  aria-controls="site-settings-panel"
>
  <Icon name="settings-2" size={15} />
</button>

<div class="settings-panel glass" id="site-settings-panel" role="dialog" aria-label="站点设置" data-settings-panel hidden>
  <div class="settings-head">
    <div>
      <p class="kicker">PREFERENCES</p>
      <b class="warm">站点设置</b>
    </div>
    <button type="button" class="control control--icon control--sm" data-settings-close aria-label="关闭设置">
      <Icon name="x" size={13} />
    </button>
  </div>

  <div class="settings-body">
    <section class="settings-group">
      <p class="settings-group-title">外观</p>
      <div class="settings-row">
        <div class="settings-copy"><b>主题</b><small>浅色、深色或跟随系统</small></div>
        <div class="settings-segment" role="group" aria-label="主题">
          <button type="button" data-setting="theme" data-value="system" aria-pressed="true">跟随系统</button>
          <button type="button" data-setting="theme" data-value="light" aria-pressed="false">浅色</button>
          <button type="button" data-setting="theme" data-value="dark" aria-pressed="false">深色</button>
        </div>
      </div>
      <div class="settings-row">
        <div class="settings-copy"><b>背景花瓣</b><small>首页背景飘落动画</small></div>
        <button type="button" class="settings-switch" role="switch" aria-label="背景花瓣" aria-checked="true" data-setting="petals"><span></span></button>
      </div>
      <div class="settings-row">
        <div class="settings-copy"><b>减少动效</b><small>关闭过渡与装饰动画</small></div>
        <button type="button" class="settings-switch" role="switch" aria-label="减少动效" aria-checked="false" data-setting="motion"><span></span></button>
      </div>
    </section>

    <section class="settings-group">
      <p class="settings-group-title">内容与阅读</p>
      <div class="settings-row">
        <div class="settings-copy"><b>NSFW 内容</b><small>显示成人向作品</small></div>
        <button type="button" class="settings-switch" data-nsfw-toggle aria-pressed="false" aria-label="显示 NSFW 内容"><span></span></button>
        <span class="sr-only" data-nsfw-label>NSFW</span>
      </div>
      <div class="settings-row">
        <div class="settings-copy"><b>笔记目录默认展开</b><small>窄屏也显示章节导航</small></div>
        <button type="button" class="settings-switch" role="switch" aria-label="笔记目录默认展开" aria-checked="false" data-setting="toc"><span></span></button>
      </div>
    </section>

    <section class="settings-group">
      <p class="settings-group-title">布局</p>
      <div class="settings-row">
        <div class="settings-copy"><b>列表密度</b><small>卡片内边距与间距</small></div>
        <div class="settings-segment" role="group" aria-label="列表密度">
          <button type="button" data-setting="density" data-value="comfortable" aria-pressed="true">舒适</button>
          <button type="button" data-setting="density" data-value="compact" aria-pressed="false">紧凑</button>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import '../scripts/site-settings';
</script>

<style>
  .settings-panel {
    position: absolute;
    z-index: 100;
    top: calc(100% + 10px);
    right: 0;
    width: min(340px, calc(100vw - 28px));
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--color-bg) 96%, transparent);
    box-shadow: 0 28px 64px -28px rgba(40, 16, 28, 0.6);
    animation: settings-in 0.15s ease;
  }

  .settings-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-line);
  }
  .settings-head .kicker { margin: 0 0 2px; font-size: 8.5px; }
  .settings-head b { font-size: 16px; font-weight: 600; }

  .settings-body { display: grid; gap: 13px; padding-top: 4px; }
  .settings-group { display: grid; gap: 4px; }
  .settings-group-title {
    margin: 0;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 36px;
  }
  .settings-copy { display: grid; gap: 1px; min-width: 0; }
  .settings-copy b { font-size: 12px; font-weight: 550; color: var(--color-text); }
  .settings-copy small { font-size: 10px; line-height: 1.4; color: var(--color-muted); }

  .settings-segment {
    display: inline-flex;
    flex: none;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--control-border);
    border-radius: var(--radius-control-sm);
    background: var(--control-bg);
  }
  .settings-segment button {
    border: 0;
    border-radius: 7px;
    background: transparent;
    padding: 5px 8px;
    color: var(--color-muted);
    font-size: 10px;
    line-height: 1.3;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .settings-segment button:hover { color: var(--color-text); }
  .settings-segment button[aria-pressed="true"] {
    background: var(--color-accent);
    color: #fff;
  }

  .settings-switch {
    position: relative;
    flex: none;
    width: 38px;
    height: 21px;
    border: 1px solid var(--control-border);
    border-radius: 999px;
    background: var(--control-bg);
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .settings-switch > span {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--color-muted);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  .settings-switch[aria-checked="true"],
  .settings-switch[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .settings-switch[aria-checked="true"] > span,
  .settings-switch[aria-pressed="true"] > span {
    transform: translateX(17px);
    background: #fff;
  }
  .settings-switch:focus-visible,
  .settings-segment button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--control-ring);
  }

  @keyframes settings-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
</style>
