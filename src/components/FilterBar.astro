---
import Icon from './Icon.astro';
import Select from './Select.astro';
import { EXPERIMENT_LABELS, TIER_LABELS, WORK_EXPERIMENTS, WORK_TIERS } from '../lib/work-meta';

interface Props {
  artists: { id: string; name: string }[];
  tags: [string, number][];
}
const { artists, tags } = Astro.props;

const artistOptions = [
  { value: '', label: '全部' },
  ...artists.map((artist) => ({ value: artist.id, label: artist.name })),
];
const tierOptions = [
  { value: '', label: '全部' },
  ...WORK_TIERS.map((tier) => ({ value: tier, label: TIER_LABELS[tier] })),
];
const experimentOptions = [
  { value: '', label: '全部' },
  ...WORK_EXPERIMENTS.map((experiment) => ({ value: experiment, label: EXPERIMENT_LABELS[experiment] })),
];
const ratingOptions = [
  { value: '', label: '全部' },
  { value: 'general', label: '一般' },
  { value: 'sensitive', label: '敏感' },
  { value: 'nsfw', label: 'NSFW' },
  { value: 'r18g', label: 'R18G' },
];
const sortOptions = [
  { value: 'newest', label: '最新' },
  { value: 'oldest', label: '最早' },
  { value: 'random', label: '随机' },
];
---
<form class="glass filter-bar" data-filter-form>
  <span class="filter-lead"><Icon name="funnel" size={12} />筛选</span>
  <div class="field">
    <span class="field-label">画师</span>
    <Select name="artist" label="画师" options={artistOptions} />
  </div>
  <div class="field">
    <span class="field-label">层级</span>
    <Select name="tier" label="层级" options={tierOptions} />
  </div>
  <div class="field">
    <span class="field-label">实验</span>
    <Select name="experiment" label="实验" options={experimentOptions} />
  </div>
  <div class="field">
    <span class="field-label">分级</span>
    <Select name="rating" label="分级" options={ratingOptions} />
  </div>
  <div class="field">
    <span class="field-label">排序</span>
    <Select name="sort" label="排序" options={sortOptions} value="newest" />
  </div>
  <button type="reset" class="control"><Icon name="rotate-ccw" size={11} />清除</button>
  <span class="result-count" data-result-count></span>
  <fieldset class="tag-field">
    <legend>标签</legend>
    <div class="tag-options">
      {tags.map(([tag, count]) => (
        <label class="tag-option">
          <input type="checkbox" name="tag" value={tag} />
          <span>#{tag}</span>
          <small>{count}</small>
        </label>
      ))}
    </div>
  </fieldset>
</form>

<style>
  .filter-bar { position: relative; z-index: 20; display: flex; align-items: end; gap: 10px; flex-wrap: wrap; padding: 12px 14px; margin-bottom: 14px; min-width: 0; }
  .filter-lead { display: inline-flex; align-items: center; gap: 5px; align-self: end; padding-bottom: 9px; color: var(--color-muted); font-size: 9px; letter-spacing: .14em; }
  .field { display: grid; gap: 4px; min-width: 0; }
  .field-label { padding-left: 2px; color: var(--color-muted); font-size: 9px; letter-spacing: .08em; }
  .result-count { margin-left: auto; font-size: 10px; color: var(--color-muted); }
  .tag-field { flex: 1 0 100%; min-width: 0; margin: 0; padding: 9px 0 0; border: 0; border-top: 1px dashed var(--color-line); }
  .tag-field legend { padding: 0; font-size: 9px; letter-spacing: .08em; color: var(--color-muted); }
  .tag-options { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; max-height: 132px; overflow-y: auto; }
  .tag-option { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; padding: 3px 9px; border: 1px solid var(--color-line); border-radius: 999px; font-size: 10px; letter-spacing: 0; color: var(--color-text); cursor: pointer; }
  .tag-option input { width: 11px; height: 11px; margin: 0; accent-color: var(--color-accent); }
  .tag-option span { overflow-wrap: anywhere; }
  .tag-option small { font-size: 9px; color: var(--color-muted); }
  .tag-option:has(input:checked) { border-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent); }
  .tag-option:has(input:checked) small { color: inherit; }
</style>
