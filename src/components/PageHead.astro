---
import Icon from './Icon.astro';

interface Props {
  kicker: string;
  title: string;
  description?: string;
  icon?: string;
  class?: string;
}

const { kicker, title, description, icon, class: className } = Astro.props;
---

<header class:list={['page-head', className]}>
  <div class="page-head-main">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  {icon && (
    <span class="page-head-badge" aria-hidden="true">
      <Icon name={icon} size={26} strokeWidth={1.5} />
    </span>
  )}
</header>

<style>
  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .page-head-main { min-width: 0; }
  .page-head-badge {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 10px 24px -18px rgba(20, 8, 16, 0.6);
    color: #fff;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  @media (max-width: 600px) {
    .page-head-badge { width: 42px; height: 42px; border-radius: 13px; }
    .page-head-badge :global(.icon) { width: 21px; height: 21px; }
  }
</style>
