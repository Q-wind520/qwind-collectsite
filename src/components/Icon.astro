---
import { Icon as IconifyIcon } from 'astro-icon/components';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 16, class: className, label, strokeWidth } = Astro.props;
const classes = ['icon', className].filter(Boolean).join(' ');
---

<IconifyIcon
  name={`lucide:${name}`}
  size={size}
  class={classes}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  style={strokeWidth ? `stroke-width:${strokeWidth}` : undefined}
/>
