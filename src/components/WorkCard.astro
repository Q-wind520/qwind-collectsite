---
import { Image } from 'astro:assets';
import { type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';
import { isNsfw } from '../lib/content';
import { EXPERIMENT_LABELS, TIER_LABELS } from '../lib/work-meta';
import { buildWorkDetail } from '../lib/work-detail';

interface Props { work: CollectionEntry<'works'>; }
const { work } = Astro.props;
const cover = work.data.images[0];
const { detail, artistNames } = await buildWorkDetail(work);
const artistSlugs = work.data.artists.map((ref) => ref.id);
const metaLabel = artistNames.length > 3
  ? `${artistNames.slice(0, 3).join(' / ')} 等 ${artistNames.length} 位`
  : artistNames.join(' / ') || TIER_LABELS[work.data.tier];
const modalJson = JSON.stringify(detail).replace(/</g, '\\u003c');
---
<article
  class="work-card"
  data-work
  data-nsfw={isNsfw(work.data.rating) ? 'true' : 'false'}
  data-artists={artistSlugs.join(' ')}
  data-tags={work.data.tags.join('|')}
  data-rating={work.data.rating}
  data-tier={work.data.tier}
  data-experiments={work.data.experiment.join('|')}
  data-date={work.data.createdAt.toISOString()}
>
  <a
    class="thumb"
    href={withBase(`/gallery/${work.data.slug}`)}
    data-work-modal-link
    aria-haspopup="dialog"
    aria-label={`查看《${work.data.title}》详情`}
  >
    <Image
      src={cover}
      alt={work.data.title}
      widths={[400, 800, 1200]}
      sizes="(max-width: 900px) 50vw, 33vw"
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="caption">
    <a class="title" href={withBase(`/gallery/${work.data.slug}`)} data-work-modal-link>{work.data.title}</a>
    <div class="meta">
      <span><Icon name="user-round" size={11} />{metaLabel}</span>
      <span><Icon name="calendar-days" size={11} />{work.data.createdAt.toISOString().slice(0, 10)}</span>
    </div>
    <div class="badges">
      <span class="badge tier" data-tier={work.data.tier}>{TIER_LABELS[work.data.tier]}</span>
      {work.data.experiment.map((experiment) => (
        <span class="badge">{EXPERIMENT_LABELS[experiment]}</span>
      ))}
    </div>
  </div>
  {modalJson && <script type="application/json" data-work-data set:html={modalJson}></script>}
</article>

<style>
  .work-card { border-radius: var(--radius-card); overflow: hidden; background: rgba(255,255,255,.55); border: 1px solid var(--glass-border); box-shadow: 0 8px 24px -18px rgba(76,40,50,.45); transition: transform .3s, box-shadow .3s; }
  .work-card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px -20px rgba(76,40,50,.5); }
  .thumb { display: block; overflow: hidden; background: rgba(0,0,0,.06); }
  .thumb :global(img) { width: 100%; height: auto; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .work-card:hover .thumb :global(img) { transform: scale(1.05); }
  .caption { padding: 10px 12px 12px; }
  .title { display: block; font-size: 13px; font-weight: 550; text-decoration: none; overflow-wrap: anywhere; }
  .title:hover { color: var(--color-accent); }
  .meta { display: flex; justify-content: space-between; gap: 8px; margin-top: 4px; font-size: 10px; color: var(--color-muted); }
  .meta span { display: inline-flex; align-items: center; gap: 4px; min-width: 0; }
  .meta span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .badges { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 7px; }
  .badge { padding: 1px 7px; border: 1px solid rgba(255,224,224,.9); border-radius: 999px; background: var(--color-accent-soft); color: var(--color-accent); font-size: 9px; line-height: 1.7; }
  .badge.tier[data-tier="sketch"] { border-color: var(--color-line); background: transparent; color: var(--color-muted); }
  .badge.tier[data-tier="showcase"] { border-color: var(--color-accent); background: var(--color-accent); color: #fff; }
</style>
