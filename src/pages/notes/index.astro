---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/PageHead.astro';
import { withBase } from '../../lib/url';

const includeDrafts = import.meta.env.DEV;
const notes = (await getCollection('notes'))
  .filter((note) => includeDrafts || !note.data.draft)
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());
const readingTime = (body: string) => Math.max(1, Math.round(body.replace(/\s+/g, '').length / 300));
---
<BaseLayout title="笔记" description="温水の收藏站的笔记与文章。">
  <div class="container page">
    <div class="notes-wrap">
      <PageHead kicker="NOTES" title="笔记" icon="notebook-pen" />
      <div class="note-list">
      {notes.map((note) => (
        <a class="glass note-card" href={withBase(`/notes/${note.data.slug}`)}>
          <span class="note-card-top">
            <span class="stat"><Icon name="calendar-days" size={11} /><time datetime={note.data.createdAt.toISOString()}>{note.data.createdAt.toISOString().slice(0, 10)}</time></span>
            <span class="dot" aria-hidden="true"></span>
            <span class="stat"><Icon name="clock" size={11} />{note.data.readingTime ?? readingTime(note.body ?? '')} 分钟</span>
          </span>
          <b class="warm note-card-title">{note.data.title}</b>
          {note.data.summary && <p class="note-card-summary">{note.data.summary}</p>}
          <span class="note-card-foot">
            <span class="note-tags">
              {note.data.tags.map((tag) => <span>#{tag}</span>)}
            </span>
            <span class="note-more" aria-hidden="true">阅读 <Icon name="arrow-right" size={12} /></span>
          </span>
        </a>
      ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notes-wrap { max-width: 940px; margin-inline: auto; }
  .note-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--list-gap);
  }
  .note-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: var(--card-pad);
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .note-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--glass-border));
    box-shadow: 0 22px 54px -32px rgba(60, 24, 38, 0.7);
  }
  .note-card-top {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--color-muted);
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }
  .note-card-top .stat { display: inline-flex; align-items: center; gap: 4px; }
  .note-card-top .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .note-card-title {
    font-size: clamp(18px, 1.2vw + 12px, 21px);
    line-height: 1.45;
    color: var(--color-text);
    transition: color 0.18s ease;
  }
  .note-card:hover .note-card-title { color: var(--color-link); }
  .note-card-summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 12.5px;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .note-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px dashed var(--color-line);
  }
  .note-tags { display: flex; flex-wrap: wrap; gap: 5px; }
  .note-tags span {
    padding: 1px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    color: var(--color-link);
    font-size: 10px;
  }
  .note-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
    color: var(--color-muted);
    font-size: 10.5px;
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .note-card:hover .note-more { color: var(--color-accent); transform: translateX(2px); }

  @media (max-width: 480px) {
    .note-card-title { font-size: 18px; }
  }
</style>
