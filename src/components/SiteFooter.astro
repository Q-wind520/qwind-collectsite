---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {year} {site.name} · 除特别声明外，内容按 <a class="license-link" href={site.license.href} target="_blank" rel="noopener noreferrer">{site.license.name}</a> 共享</span>
    <span class="footer-links">
      <a href={withBase('/about')}><Icon name="info" size={11} />关于</a>
      <a href={withBase('/rss.xml')}><Icon name="rss" size={11} />RSS</a>
      <a href="https://github.com/Q-wind520" target="_blank" rel="noopener noreferrer"><Icon name="github" size={11} />GitHub</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(20px, 2.8vw, 30px) 0; padding-bottom: max(clamp(26px, 3.6vw, 44px), env(safe-area-inset-bottom)); color: rgba(255, 255, 255, 0.82); font-size: 10px; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35); }
  .footer-inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .footer-links { display: inline-flex; flex-wrap: wrap; gap: 14px; }
  a { display: inline-flex; align-items: center; gap: 4px; text-decoration: none; }
  a:hover { color: #fff; }
  .license-link { display: inline; text-decoration: underline; text-underline-offset: 2px; }
</style>
