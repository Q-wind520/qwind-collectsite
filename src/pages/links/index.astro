---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkCard from '../../components/LinkCard.astro';
import PageHead from '../../components/PageHead.astro';
import Select from '../../components/Select.astro';

const includeDrafts = import.meta.env.DEV;
const links = (await getCollection('links'))
  .filter((link) => includeDrafts || !link.data.draft)
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());
const domains = [...new Set(links.map((link) => new URL(link.data.url).hostname))].sort();
const tags = [...new Set(links.flatMap((link) => link.data.tags))].sort();
const domainOptions = [
  { value: '', label: '全部域名' },
  ...domains.map((domain) => ({ value: domain, label: domain })),
];
const tagOptions = [
  { value: '', label: '全部标签' },
  ...tags.map((tag) => ({ value: tag, label: tag })),
];
---
<BaseLayout title="书签" description="温水の收藏站的网页收藏。">
  <div class="container page">
    <PageHead kicker="LINKS" title="书签" icon="bookmark" />
    <div class="glass link-tools">
      <Select name="domain" label="按域名筛选" options={domainOptions} data-link-domain />
      <Select name="tag" label="按标签筛选" options={tagOptions} data-link-tag />
    </div>
    <div class="link-list" data-link-list>
      {links.map((link) => <LinkCard link={link} />)}
    </div>
  </div>
  <script>import '../../scripts/link-filter';</script>
</BaseLayout>

<style>
  .link-tools { position: relative; z-index: 20; display: flex; gap: 8px; padding: 10px 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .link-tools :global(.select-trigger) { min-width: 156px; }
  .link-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--list-gap); }
  @media (max-width: 760px) { .link-list { grid-template-columns: 1fr; } }
</style>
