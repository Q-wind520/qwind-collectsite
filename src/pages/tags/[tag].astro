---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/PageHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import { collectAllTags, tagRoutes, validateSlugs } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const [works, links, notes, files] = await Promise.all([
    getCollection('works'), getCollection('links'), getCollection('notes'), getCollection('files'),
  ]);
  const tags = collectAllTags([...works, ...links, ...notes, ...files]);
  return tagRoutes(tags)
    .map((item) => ({ params: { tag: item.slug }, props: { tag: item.tag } }));
}

const { tag } = Astro.props;
const [works, links, notes, files] = await Promise.all([
  getCollection('works'), getCollection('links'), getCollection('notes'), getCollection('files'),
]);
for (const collection of [works, links, notes, files]) validateSlugs(collection);
const match = (entry: { data: { tags: string[] } }) => entry.data.tags.includes(tag);
const taggedWorks = works.filter((entry) => !entry.data.draft && match(entry));
const taggedLinks = links.filter((entry) => !entry.data.draft && match(entry));
const taggedNotes = notes.filter((entry) => !entry.data.draft && match(entry));
const taggedFiles = files.filter((entry) => !entry.data.draft && match(entry));
---
<BaseLayout title={`#${tag}`} description={`标签 #${tag} 下的收藏。`}>
  <div class="container page">
    <PageHead kicker="TAG" title={`#${tag}`} description={`标签 #${tag} 下的收藏。`} icon="tags" />
    {taggedWorks.length > 0 && <section class="tag-section"><h2><Icon name="image" size={16} />作品</h2><div class="grid" data-masonry>{taggedWorks.map((work) => <WorkCard work={work} />)}</div></section>}
    <section class="glass tag-list">
      {taggedLinks.map((entry) => <a href={withBase('/links')}><Icon name="bookmark" size={12} />书签 · {entry.data.title}</a>)}
      {taggedNotes.map((entry) => <a href={withBase(`/notes/${entry.data.slug}`)}><Icon name="notebook-pen" size={12} />笔记 · {entry.data.title}</a>)}
      {taggedFiles.map((entry) => <a href={withBase('/files')}><Icon name="file" size={12} />文件 · {entry.data.title}</a>)}
    </section>
  </div>
</BaseLayout>

<style>
  .tag-section { margin-bottom: 16px; }
  .tag-section h2 { display: inline-flex; align-items: center; gap: 6px; color: #fff; font-size: 18px; margin: 0 0 10px; }
  .tag-list { display: grid; gap: 2px; padding: 8px 14px; }
  .tag-list a { display: inline-flex; align-items: center; gap: 7px; padding: 9px 0; border-bottom: 1px solid var(--color-line); text-decoration: none; font-size: 12px; }
  .tag-list a:hover { color: var(--color-accent); }

</style>
