---
---
<dialog class="work-modal" data-work-modal aria-label="作品详情">
  <div class="work-modal-frame">
    <button type="button" class="work-modal-close" data-work-modal-close aria-label="关闭作品详情">✕</button>
    <div class="work-modal-loading" data-work-modal-loading aria-live="polite">载入作品…</div>
    <iframe data-work-modal-frame title="作品详情" loading="eager"></iframe>
  </div>
</dialog>
<script>import '../scripts/work-modal';</script>

<style is:global>
  html.modal-open { overflow: hidden; }
  .work-modal {
    width: min(1080px, calc(100vw - 28px));
    height: min(88vh, 960px);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    color: var(--color-text);
  }
  .work-modal::backdrop {
    background: rgba(24, 18, 22, 0.42);
    backdrop-filter: blur(18px) saturate(1.12);
    -webkit-backdrop-filter: blur(18px) saturate(1.12);
  }
  .work-modal-frame {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-panel);
    border: 1px solid rgba(255, 255, 255, 0.36);
    background: var(--glass-bg);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    box-shadow: 0 30px 90px -34px rgba(20, 8, 16, 0.72);
  }
  .work-modal iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    color-scheme: inherit;
  }
  .work-modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--glass-bg);
    color: var(--color-muted);
    font-size: 14px;
    cursor: pointer;
    backdrop-filter: blur(10px);
  }
  .work-modal-close:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .work-modal-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    background: var(--glass-bg);
    pointer-events: none;
  }
  .work-modal-loading[hidden] { display: none; }
  @media (max-width: 760px) {
    .work-modal {
      width: calc(100vw - 16px);
      height: calc(100dvh - 16px);
    }
    .work-modal-frame { border-radius: 16px; }
  }
</style>
