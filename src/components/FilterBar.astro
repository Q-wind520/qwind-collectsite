---
import { EXPERIMENT_LABELS, TIER_LABELS, WORK_EXPERIMENTS, WORK_TIERS } from '../lib/work-meta';

interface Props {
  artists: { id: string; name: string }[];
  tags: [string, number][];
}
const { artists, tags } = Astro.props;
---
<form class="glass filter-bar" data-filter-form>
  <label class="field">画师
    <select name="artist">
      <option value="">全部</option>
      {artists.map((artist) => <option value={artist.id}>{artist.name}</option>)}
    </select>
  </label>
  <label class="field">层级
    <select name="tier">
      <option value="">全部</option>
      {WORK_TIERS.map((tier) => <option value={tier}>{TIER_LABELS[tier]}</option>)}
    </select>
  </label>
  <label class="field">实验
    <select name="experiment">
      <option value="">全部</option>
      {WORK_EXPERIMENTS.map((experiment) => <option value={experiment}>{EXPERIMENT_LABELS[experiment]}</option>)}
    </select>
  </label>
  <label class="field">分级
    <select name="rating">
      <option value="">全部</option>
      <option value="general">一般</option>
      <option value="sensitive">敏感</option>
      <option value="nsfw">NSFW</option>
      <option value="r18g">R18G</option>
    </select>
  </label>
  <label class="field">排序
    <select name="sort">
      <option value="newest">最新</option>
      <option value="oldest">最早</option>
      <option value="random">随机</option>
    </select>
  </label>
  <button type="reset">清除</button>
  <span class="result-count" data-result-count></span>
  <fieldset class="tag-field">
    <legend>标签</legend>
    <div class="tag-options">
      {tags.map(([tag, count]) => (
        <label class="tag-option">
          <input type="checkbox" name="tag" value={tag} />
          <span>#{tag}</span>
          <small>{count}</small>
        </label>
      ))}
    </div>
  </fieldset>
</form>

<style>
  .filter-bar { display: flex; align-items: end; gap: 10px; flex-wrap: wrap; padding: 12px 14px; margin-bottom: 14px; min-width: 0; }
  .field { display: grid; gap: 3px; font-size: 9px; letter-spacing: .08em; color: var(--color-muted); min-width: 0; }
  select { max-width: 100%; border: 1px solid var(--color-line); border-radius: 999px; background: rgba(255,255,255,.65); padding: 6px 10px; font-size: 11px; color: var(--color-text); }
  button { border: 1px solid var(--color-line); border-radius: 999px; background: transparent; padding: 6px 12px; font-size: 11px; color: var(--color-muted); cursor: pointer; }
  button:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .result-count { margin-left: auto; font-size: 10px; color: var(--color-muted); }
  .tag-field { flex: 1 0 100%; min-width: 0; margin: 0; padding: 9px 0 0; border: 0; border-top: 1px dashed var(--color-line); }
  .tag-field legend { padding: 0; font-size: 9px; letter-spacing: .08em; color: var(--color-muted); }
  .tag-options { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; max-height: 132px; overflow-y: auto; }
  .tag-option { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; padding: 3px 9px; border: 1px solid var(--color-line); border-radius: 999px; font-size: 10px; letter-spacing: 0; color: var(--color-text); cursor: pointer; }
  .tag-option input { width: 11px; height: 11px; margin: 0; accent-color: var(--color-accent); }
  .tag-option span { overflow-wrap: anywhere; }
  .tag-option small { font-size: 9px; color: var(--color-muted); }
  .tag-option:has(input:checked) { border-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent); }
  .tag-option:has(input:checked) small { color: inherit; }
</style>
