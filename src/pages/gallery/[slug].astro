---
import { getCollection, getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import Lightbox from '../../components/Lightbox.astro';
import { assetUrl, withBase } from '../../lib/url';
import { isNsfw, tagToSlug } from '../../lib/content';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const works = await getCollection('works');
  return works
    .filter((work) => includeDrafts || !work.data.draft)
    .map((work) => ({ params: { slug: work.data.slug }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const cover = work.data.images[0];
const large = await getImage({ src: cover, width: 1600, format: 'webp' });
const artists = await Promise.all(work.data.artists.map((ref) => getEntry(ref)));
if (artists.some((entry) => !entry)) throw new Error(`Missing artist reference in work "${work.id}"`);
const nsfw = isNsfw(work.data.rating);
const metaTitle = nsfw ? 'NSFW 内容' : work.data.title;
const metaDescription = nsfw ? 'NSFW 内容，默认隐藏。' : work.data.summary;
const metaImage = nsfw ? '/og-default.png' : large.src;
const shouldNoindex = nsfw;
const kindLabels = { painting: '画作', style: '画风', composition: '构图' } as const;
const kindLabel = kindLabels[work.data.kind];
const positiveLabel = work.data.kind === 'style'
  ? '画师串'
  : work.data.kind === 'composition'
    ? '构图 / 场景串'
    : '正向提示词';
const positiveText = work.data.kind === 'style'
  ? (work.data.prompt.artist || work.data.prompt.positive)
  : work.data.kind === 'composition'
    ? (work.data.prompt.scene || work.data.prompt.positive)
    : work.data.prompt.positive;
const positiveAction = work.data.kind === 'style'
  ? '复制画师串'
  : work.data.kind === 'composition'
    ? '复制构图串'
    : '复制正向';
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  image={metaImage}
  noindex={shouldNoindex}
>
  <div class="container page" id="work-lightbox">
    {nsfw && (
      <div class="nsfw-notice glass" data-nsfw-notice>
        <p class="kicker">NSFW</p>
        <h2 class="warm">此内容默认隐藏</h2>
        <p>包含成人向内容。开启 NSFW 显示并完成成年确认后查看。</p>
        <button type="button" data-nsfw-enable>开启 NSFW 内容</button>
      </div>
    )}
    <div data-nsfw={nsfw ? 'true' : 'false'}>
      <article class="glass work-detail">
      <div class="work-media">
        <a href={assetUrl(large.src)} data-pswp data-pswp-width={cover.width} data-pswp-height={cover.height} aria-label={`查看《${work.data.title}》大图`}>
          <Image src={cover} alt={work.data.title} widths={[600, 1200, 1600]} sizes="(max-width: 760px) 100vw, 60vw" format="webp" loading="eager" />
        </a>
        {work.data.images.length > 1 && (
          <div class="work-thumbs">
            {work.data.images.slice(1).map((image) => (
              <a href={assetUrl(image.src)} data-pswp data-pswp-width={image.width} data-pswp-height={image.height} aria-label="查看大图">
                <Image src={image} alt="" widths={[160, 320]} format="webp" loading="lazy" />
              </a>
            ))}
          </div>
        )}
      </div>
      <div class="work-info">
        <p class="kicker">WORK / {kindLabel} / {work.data.rating.toUpperCase()}</p>
        <h1 class="warm">{work.data.title}</h1>
        {work.data.summary && <p class="summary">{work.data.summary}</p>}
        <dl class="facts">
          <div><dt>日期</dt><dd>{work.data.createdAt.toISOString().slice(0, 10)}</dd></div>
          <div><dt>画师</dt><dd>{artists.filter(Boolean).map((artist) => artist!.data.title).join(' / ') || '—'}</dd></div>
          <div><dt>模型</dt><dd>{work.data.prompt.model || '—'}</dd></div>
          <div><dt>分级</dt><dd>{work.data.rating}</dd></div>
        </dl>
        <div class="tags">
          {work.data.tags.map((tag) => {
            const slug = tagToSlug(tag);
            return slug ? <a href={withBase(`/tags/${slug}`)}>#{tag}</a> : <span>#{tag}</span>;
          })}
        </div>
        <PromptBlock positive={positiveText} negative={work.data.prompt.negative} positiveLabel={positiveLabel} positiveAction={positiveAction} />
      </div>
      </article>
      <div class="glass work-body"><Content /></div>
    </div>
  </div>
  <Lightbox gallerySelector="#work-lightbox" />
</BaseLayout>

<style>
  .work-detail { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr); gap: 20px; padding: 20px; min-width: 0; }
  .work-info { min-width: 0; }
  .work-media { min-width: 0; }
  .work-media a { display: block; border-radius: 14px; overflow: hidden; }
  .work-media :global(img) { width: 100%; height: auto; }
  .work-thumbs { display: flex; gap: 6px; margin-top: 6px; }
  .work-thumbs a { width: 64px; height: 48px; border-radius: 8px; }
  .work-thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-info h1 { margin: 6px 0 10px; font-size: clamp(28px, 4vw, 42px); line-height: 1.15; }
  .summary { color: var(--color-muted); font-size: 13px; overflow-wrap: anywhere; }
  .facts { display: grid; gap: 8px; margin: 16px 0; }
  .facts div { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 6px; border-bottom: 1px solid var(--color-line); min-width: 0; }
  .facts dt { font-size: 10px; letter-spacing: .1em; color: var(--color-muted); flex: none; }
  .facts dd { margin: 0; font-size: 12px; overflow-wrap: anywhere; text-align: right; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .tags a, .tags span { font-size: 11px; color: var(--color-accent); text-decoration: none; overflow-wrap: anywhere; }
  .work-body { margin-top: 14px; padding: 20px; }
  .nsfw-notice { padding: 24px; margin-bottom: 14px; display: grid; gap: 8px; }
  .nsfw-notice h2 { margin: 0; font-size: 24px; }
  .nsfw-notice p { margin: 0; color: var(--color-muted); font-size: 12px; }
  .nsfw-notice button { justify-self: start; border: 1px solid var(--color-line); border-radius: 999px; background: var(--color-accent); color: #fff; padding: 8px 14px; font-size: 12px; cursor: pointer; }
  @media (max-width: 760px) { .work-detail { grid-template-columns: 1fr; padding: 14px; } }
</style>
