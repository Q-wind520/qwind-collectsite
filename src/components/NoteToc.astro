---
import Icon from './Icon.astro';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth <= 3);
---

<aside class="note-toc" aria-label="本页目录" data-note-toc>
  <div class="toc-progress" aria-hidden="true"><i data-toc-progress></i></div>
  <details class="toc-details" open data-toc-details>
    <summary>
      <span class="toc-title">目录</span>
      <small data-toc-count>{items.length} 节</small>
      <Icon name="chevron-down" size={12} class="toc-chevron" />
    </summary>
    <nav class="toc-nav">
      {items.map((heading) => (
        <a
          href={`#${heading.slug}`}
          data-toc-link
          data-depth={heading.depth}
          class:list={{ 'is-sub': heading.depth > 2 }}
        >{heading.text}</a>
      ))}
    </nav>
  </details>
</aside>

<script>
  import '../scripts/note-toc';
</script>

<style>
  .note-toc {
    grid-area: toc;
    position: sticky;
    top: 76px;
    align-self: start;
    max-height: calc(100vh - 96px);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--prose-quote-bg);
    overflow: hidden;
  }

  .toc-progress {
    height: 3px;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .toc-progress i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 0 3px 3px 0;
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 55%, var(--color-link)));
    transition: width 0.12s linear;
  }

  .toc-details { border: 0; }
  .toc-details > summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px;
    color: var(--color-text);
    font-family: var(--font-warm);
    font-size: 14px;
    cursor: pointer;
    list-style: none;
  }
  .toc-details > summary::-webkit-details-marker { display: none; }
  .toc-details[open] :global(.toc-chevron) { transform: rotate(180deg); }
  :global(.toc-chevron) { margin-left: auto; color: var(--color-muted); transition: transform 0.18s ease; }
  .toc-details[open] > summary { border-bottom: 1px solid var(--color-line); }

  .toc-title { letter-spacing: 0.08em; }
  .toc-details small { color: var(--color-muted); font-family: var(--font-sans); font-size: 10px; }

  .toc-nav {
    display: grid;
    gap: 1px;
    max-height: calc(100vh - 170px);
    padding: 8px;
    overflow-y: auto;
  }

  .toc-nav a {
    padding: 5px 9px;
    border-left: 2px solid transparent;
    border-radius: 0 7px 7px 0;
    color: var(--color-muted);
    font-size: 11.5px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .toc-nav a.is-sub { padding-left: 20px; font-size: 11px; opacity: 0.88; }
  .toc-nav a:hover { color: var(--color-link); background: color-mix(in srgb, var(--color-accent) 8%, transparent); }
  .toc-nav a[aria-current="location"] {
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 13%, transparent);
    color: var(--color-link);
    font-weight: 600;
  }

  @media (max-width: 1079px) {
    .note-toc {
      position: static;
      max-height: none;
      margin: 18px 0 4px;
    }
    .toc-nav { max-height: 44vh; }
    .toc-details:not([open]) > summary { border-bottom: 0; }
  }
</style>
