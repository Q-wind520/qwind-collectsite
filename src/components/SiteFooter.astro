---
import { site } from '../config/site';
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {year} {site.name} · 除特别声明外，内容按 <a class="license-link" href={site.license.href} target="_blank" rel="noopener noreferrer">{site.license.name}</a> 共享</span>
    <span>
      <a href={withBase('/about')}>关于</a>
      <a href={withBase('/protected')}>受保护</a>
      <a href={withBase('/rss.xml')}>RSS</a>
      <a href="https://github.com/Q-wind520" target="_blank" rel="noopener noreferrer">GitHub</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { padding: 18px 0 28px; color: rgba(255, 255, 255, 0.82); font-size: 10px; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35); }
  .footer-inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  a { text-decoration: none; margin-left: 12px; }
  a:hover { color: #fff; }
  .license-link { margin-left: 0; text-decoration: underline; text-underline-offset: 2px; }
</style>
