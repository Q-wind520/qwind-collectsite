---
import { Image, getImage } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import { assetUrl, withBase } from '../lib/url';
import { isNsfw, tagToSlug } from '../lib/content';

interface Props { work: CollectionEntry<'works'>; modalData?: boolean; }
const { work, modalData = false } = Astro.props;
const cover = work.data.images[0];
const artistEntries = await Promise.all(work.data.artists.map((ref) => getEntry(ref)));
if (artistEntries.some((entry) => !entry)) throw new Error(`Missing artist reference in work "${work.id}"`);
const artistNames = artistEntries.filter(Boolean).map((entry) => entry!.data.title);
const artistSlugs = work.data.artists.map((ref) => ref.id);
const kindLabels = { painting: '画作', style: '画风', composition: '构图' } as const;
const metaLabel = artistNames.join(' / ') || kindLabels[work.data.kind];
const positiveLabel = work.data.kind === 'style'
  ? '画师串'
  : work.data.kind === 'composition'
    ? '构图 / 场景串'
    : '正向提示词';
const positiveAction = work.data.kind === 'style'
  ? '复制画师串'
  : work.data.kind === 'composition'
    ? '复制构图串'
    : '复制正向';
const positive = work.data.kind === 'style'
  ? (work.data.prompt.artist || work.data.prompt.positive)
  : work.data.kind === 'composition'
    ? (work.data.prompt.scene || work.data.prompt.positive)
    : work.data.prompt.positive;
const large = modalData ? await getImage({ src: cover, width: 1600, format: 'webp' }) : null;
const modalDetail = modalData ? {
  title: work.data.title,
  summary: work.data.summary ?? '',
  date: work.data.createdAt.toISOString().slice(0, 10),
  kind: kindLabels[work.data.kind],
  rating: work.data.rating,
  model: work.data.prompt.model || '—',
  artists: artistNames.join(' / ') || '—',
  tags: work.data.tags.map((tag) => {
    const slug = tagToSlug(tag);
    return { label: tag, href: slug ? withBase(`/tags/${slug}`) : null };
  }),
  image: {
    src: assetUrl(large!.src),
    width: cover.width,
    height: cover.height,
    alt: work.data.title,
  },
  positive,
  positiveLabel,
  positiveAction,
  negative: work.data.prompt.negative,
  href: withBase(`/gallery/${work.data.slug}`),
} : null;
const modalJson = modalDetail ? JSON.stringify(modalDetail).replace(/</g, '\\u003c') : null;
---
<article
  class="work-card"
  data-work
  data-kind={work.data.kind}
  data-nsfw={isNsfw(work.data.rating) ? 'true' : 'false'}
  data-artists={artistSlugs.join(' ')}
  data-tags={work.data.tags.join('|')}
  data-rating={work.data.rating}
  data-date={work.data.createdAt.toISOString()}
>
  <a
    class="thumb"
    href={withBase(`/gallery/${work.data.slug}`)}
    data-work-modal-link
    aria-haspopup="dialog"
    aria-label={`查看《${work.data.title}》详情`}
  >
    <Image
      src={cover}
      alt={work.data.title}
      widths={[400, 800, 1200]}
      sizes="(max-width: 760px) 50vw, 33vw"
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="caption">
    <a class="title" href={withBase(`/gallery/${work.data.slug}`)} data-work-modal-link>{work.data.title}</a>
    <div class="meta">
      <span>{metaLabel}</span>
      <span>{work.data.createdAt.toISOString().slice(0, 10)}</span>
    </div>
  </div>
  {modalJson && <script type="application/json" data-work-data set:html={modalJson}></script>}
</article>

<style>
  .work-card { border-radius: var(--radius-card); overflow: hidden; background: rgba(255,255,255,.55); border: 1px solid var(--glass-border); box-shadow: 0 8px 24px -18px rgba(76,40,50,.45); transition: transform .3s, box-shadow .3s; }
  .work-card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px -20px rgba(76,40,50,.5); }
  .thumb { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: rgba(0,0,0,.06); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .work-card:hover .thumb :global(img) { transform: scale(1.05); }
  .caption { padding: 10px 12px 12px; }
  .title { display: block; font-size: 13px; font-weight: 550; text-decoration: none; overflow-wrap: anywhere; }
  .title:hover { color: var(--color-accent); }
  .meta { display: flex; justify-content: space-between; gap: 8px; margin-top: 4px; font-size: 10px; color: var(--color-muted); }
</style>
